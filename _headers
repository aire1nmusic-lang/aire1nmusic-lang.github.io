/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*
  Cache-Control: no-cache

# Rules that match one path are merged, so `no-cache` from /* has to be removed first,
# otherwise the browser still re-validates every picture and script on every use.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/media/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
